int Canvas::textWidth(const std::string& s, int scale, bool bold) {
    int w = 0;
    for (size_t i = 0; i < s.size();) w += glyphFor(nextCodepoint(s, i)).adv;
    return (w > 0 ? w - 1 : 0) * scale + (bold ? 1 : 0);
}

int Canvas::text(int x, int y, const std::string& s, const TextStyle& st) {
    int cx = x;
    auto draw = [&](int ox, int oy, Color col, int a) {
        int px = ox;
        for (size_t i = 0; i < s.size();) {
            const Glyph& g = glyphFor(nextCodepoint(s, i));
            for (int r = 0; r < g.nRows; ++r)
                for (int c = 0; c < 5; ++c)
                    if (g.rows[r] & (1u << (4 - c)))
                        fillRect({px + c * st.scale, oy + (g.firstRow + r) * st.scale, st.scale, st.scale}, col, a);
            px += g.adv * st.scale;
        }
    };
    if (st.shadow) draw(cx + 1, y + 1, Color(0, 0, 0), st.alpha * 3 / 4);
    draw(cx, y, st.color, st.alpha);
    if (st.bold) draw(cx + 1, y, st.color, st.alpha);
    return textWidth(s, st.scale, st.bold);
}

int Canvas::textRight(int xr, int y, const std::string& s, const TextStyle& st) { return text(xr - textWidth(s, st.scale, st.bold), y, s, st); }
int Canvas::textCenter(int xc, int y, const std::string& s, const TextStyle& st) { return text(xc - textWidth(s, st.scale, st.bold) / 2, y, s, st); }

