struct Glyph { uint8_t rows[10] = {0}; int firstRow = 0, nRows = 0, adv = 6; };

uint32_t nextCodepoint(const std::string& s, size_t& i) {
    unsigned char c = static_cast<unsigned char>(s[i]);
    if (c < 0x80) { ++i; return c; }
    int n = (c >> 5) == 6 ? 1 : (c >> 4) == 14 ? 2 : (c >> 3) == 30 ? 3 : 0;
    uint32_t cp = n == 1 ? (c & 0x1F) : n == 2 ? (c & 0x0F) : n == 3 ? (c & 0x07) : c;
    ++i;
    for (int k = 0; k < n && i < s.size(); ++k, ++i) cp = (cp << 6) | (static_cast<unsigned char>(s[i]) & 0x3F);
    return cp;
}

Glyph glyphFor(uint32_t cp) {
    if (cp == ' ') {
        Glyph g;
        g.adv = 3;
        return g;
    }

    const GlyphDef* found = nullptr;
    for (const auto& def : kGlyphs) {
        if (def.cp == cp) {
            found = &def;
            break;
        }
    }

    if (!found) {
        for (const auto& def : kGlyphs) {
            if (def.cp == '?') {
                found = &def;
                break;
            }
        }
    }

    Glyph g;
    if (!found) return g;

    const char* s = found->spec;
    g.firstRow = *s - '0';
    s += 2;

    int maxCol = 0;
    int row = 0;

    while (*s && row < 10) {
        uint8_t bits = 0;

        for (int c = 0; c < 5 && s[c] && s[c] != '/'; ++c) {
            if (s[c] == '#') {
                bits |= uint8_t(1u << (4 - c));
                if (c + 1 > maxCol) maxCol = c + 1;
            }
        }

        g.rows[row++] = bits;
        s += 5;
        if (*s == '/') ++s;
    }

    g.nRows = row;

    const bool digit = found->cp >= '0' && found->cp <= '9';
    g.adv = digit ? 6 : (maxCol > 1 ? maxCol : 1) + 1;

    if (found->cp == 0x25B2 || found->cp == 0x25BC ||
        found->cp == 0x25C0 || found->cp == 0x25B6 ||
        found->cp == 0x203A || found->cp == 0x25CF) {
        g.adv = 6;
    }

    return g;
}

